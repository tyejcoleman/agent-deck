# ---------- helpers ----------
def die(msg):
    raise SystemExit("deck: %s" % msg)


def now():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def iso(t):
    return t.strftime("%Y-%m-%dT%H:%M:%SZ")


def ts(s):
    return dt.datetime.strptime(s[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=dt.timezone.utc)


def dur(s):
    m = re.fullmatch(r"(\d+)\s*([smhdw])", str(s).strip())
    if not m:
        die("bad duration %r (use 30m, 5h, 2d, 1w)" % s)
    return int(m.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}[m.group(2)]


def fdur(sec):
    sec = int(max(sec, 0))
    if sec >= 86400:
        return "%dd%dh" % (sec // 86400, sec % 86400 // 3600)
    if sec >= 3600:
        return "%dh%02dm" % (sec // 3600, sec % 3600 // 60)
    return "%dm%02ds" % (sec // 60, sec % 60)


def who(a):
    return getattr(a, "by", None) or os.environ.get("DECK_AGENT") or "deck"


def out(a, data, text=None):
    print(json.dumps(data, indent=2) if a.json or text is None else text)


def table(head, rows):
    rows = [[str(c) for c in r] for r in rows]
    w = [max(len(x) for x in col) for col in zip(head, *rows)]
    return "\n".join("  ".join(x.ljust(n) for x, n in zip(r, w)).rstrip() for r in [head] + rows)


def read_text_arg(a):
    if getattr(a, "text", None):
        return a.text
    f = getattr(a, "file", None)
    if f == "-":
        return sys.stdin.read()
    return Path(f).read_text(encoding="utf-8") if f else None


def parse_reset(text):
    """Vendor limit messages carry a reset hint: an epoch after '|' (Claude Code), 'try again at 7:58 PM' (local clock),
    or 'resets in 2 hours 10 minutes'. Returns an ISO UTC time or None."""
    m = re.search(r"limit reached\|(\d{10})", text)
    if m:
        return _epoch_iso(m.group(1))
    m = re.search(r"(?i)(?:try again|resets?|available)(?: again)?(?: at)?\s+(\d{1,2})(?::(\d{2}))?\s*([ap])\.?m\b", text)
    if m:
        h, mi = int(m.group(1)) % 12 + (12 if m.group(3).lower() == "p" else 0), int(m.group(2) or 0)
        local = dt.datetime.now().astimezone()
        cand = local.replace(hour=h, minute=mi, second=0, microsecond=0)
        if cand <= local:
            cand += dt.timedelta(days=1)
        return iso(cand.astimezone(dt.timezone.utc))
    m = re.search(r"(?i)(?:try again|resets?|available)(?: again)? in\s+(?:(\d+)\s*h(?:ours?)?)?\s*(?:(\d+)\s*m(?:in(?:ute)?s?)?)?", text)
    if m and (m.group(1) or m.group(2)):
        return iso(now() + dt.timedelta(hours=int(m.group(1) or 0), minutes=int(m.group(2) or 0)))
    return None


def parse_status(text):
    m = re.search(r"(?i)status[^A-Za-z]*(END|BLOCKED|FAILED)\b", text or "")
    return m.group(1).upper() if m else "END"


def scan_json(output):
    """JSON objects in worker output: one document (Claude, Gemini) or JSONL (Codex, stream modes)."""
    try:
        obj = json.loads(output)
        return [obj] if isinstance(obj, dict) else []
    except ValueError:
        objs = []
        for line in output.splitlines():
            try:
                obj = json.loads(line)
                objs.append(obj) if isinstance(obj, dict) else None
            except ValueError:
                pass
        return objs


def parse_usage(output):
    """Tokens/cost from vendor JSON: Claude `usage`+`total_cost_usd`, Codex `turn.completed.usage`, Cursor camelCase `usage`, Gemini `stats.models`."""
    u = {"tokens_in": 0, "tokens_out": 0, "cost_usd": 0.0}
    for o in scan_json(output):
        us = o.get("usage") if isinstance(o.get("usage"), dict) else {}
        u["tokens_in"] += sum(int(us.get(k) or 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens",
                                                             "inputTokens", "cacheReadTokens", "cacheWriteTokens"))  # Claude/Codex snake, Cursor camel
        u["tokens_out"] += int(us.get("output_tokens") or us.get("outputTokens") or 0)
        u["cost_usd"] += float(o.get("total_cost_usd") or 0)
        for m in (((o.get("stats") or {}).get("models") or {}) if isinstance(o.get("stats"), dict) else {}).values():
            t = (m or {}).get("tokens") or {}
            u["tokens_in"] += int(t.get("prompt") or t.get("input") or 0)
            u["tokens_out"] += int(t.get("candidates") or 0)
    return {k: v for k, v in u.items() if v}


def result_text(output, lines=40):
    """Best-effort final message: Claude `result`, Gemini `response`, Codex last agent_message / error, else the tail."""
    final = None
    for o in scan_json(output):
        item = o.get("item") or {}
        for cand in (o.get("result"), o.get("response"), item.get("text") if item.get("type") == "agent_message" else None):
            if isinstance(cand, str) and cand.strip():
                final = cand
        if isinstance(o.get("error"), dict) and o["error"].get("message"):
            final = "error: %s" % o["error"]["message"]
    return final or "\n".join(output.strip().splitlines()[-lines:])


# ---------- secrets & auth (nothing here ever touches .deck/) ----------
def secret_backend():
    forced = os.environ.get("DECK_SECRETS")
    if forced:
        return forced
    if sys.platform == "darwin" and shutil.which("security"):
        return "keychain"
    return "libsecret" if shutil.which("secret-tool") else "file"


def secret_get(aid):
    env = os.environ.get("DECK_SECRET_" + re.sub(r"\W", "_", aid).upper())
    if env:
        return env
    b = secret_backend()
    if b == "keychain":
        r = subprocess.run(["security", "find-generic-password", "-s", "deck", "-a", aid, "-w"], capture_output=True, text=True)
        return r.stdout.strip() or None
    if b == "libsecret":
        r = subprocess.run(["secret-tool", "lookup", "service", "deck", "account", aid], capture_output=True, text=True)
        return r.stdout.strip() or None
    f = Path(SECRETS).expanduser() / aid
    return f.read_text(encoding="utf-8").strip() or None if f.exists() else None


def secret_set(aid, value):
    b = secret_backend()
    if b == "keychain":
        subprocess.run(["security", "add-generic-password", "-U", "-s", "deck", "-a", aid, "-w", value], check=True, capture_output=True)
    elif b == "libsecret":
        subprocess.run(["secret-tool", "store", "--label", "deck " + aid, "service", "deck", "account", aid], input=value, text=True, check=True)
    else:
        d = Path(SECRETS).expanduser()
        d.mkdir(parents=True, exist_ok=True)
        os.chmod(str(d), 0o700)
        fd = os.open(str(d / aid), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(value)
    return b


def secret_del(aid):
    b = secret_backend()
    if b == "keychain":
        subprocess.run(["security", "delete-generic-password", "-s", "deck", "-a", aid], capture_output=True)
    elif b == "libsecret":
        subprocess.run(["secret-tool", "clear", "service", "deck", "account", aid], capture_output=True)
    else:
        f = Path(SECRETS).expanduser() / aid
        f.exists() and f.unlink()


def acct_env(acct):
    """Environment the vendor CLI gets for this account. May contain the API key: pass to processes, never print."""
    env = {k: os.path.expanduser(str(v)) for k, v in acct.get("env", {}).items()}
    if acct.get("auth") == "apikey" and acct.get("key_env"):
        secret = secret_get(acct["id"])
        if secret:
            env[acct["key_env"]] = secret
    return env


def check_account(deck, acct, quiet=True):
    """Refresh acct['check'] = {ok, at, msg} without exposing secrets. Emits AUTH only when the state flips."""
    v, env, auth = VENDORS.get(acct.get("vendor"), {}), dict(os.environ, **acct_env(acct)), acct.get("auth", "none")
    ok, msg, models, prevc, missing = True, "ok", None, acct.get("check") or {}, False
    if auth == "apikey":
        secret = secret_get(acct["id"])
        ok, msg = bool(secret), "key in %s" % secret_backend() if secret else "no key stored"
        if secret and prevc.get("rejected") == hashlib.sha256(secret.encode()).hexdigest()[:12]:
            ok, msg = False, "key rejected by the vendor; store a new one"
    elif auth == "oauth":
        st = acct.get("status_cmd") or v.get("status")
        binary = (v.get("cmd") or "").split(" ")[0]
        if binary and not shutil.which(binary):
            ok, msg, missing = False, "%s is not installed: %s" % (binary, v.get("install") or "install the vendor CLI"), True
            st = None
        if not st and ok:
            msg = "unknown (no status command; set status_cmd)"
        elif st and st.startswith("file:"):
            ok = (Path(env.get(v.get("home") or "", os.path.expanduser("~"))) / st[5:]).exists()
            msg = "logged in" if ok else "not logged in"
        elif st:
            try:
                r = subprocess.run(st, shell=True, env=env, capture_output=True, text=True, timeout=60)
                ok = r.returncode == 0 and not re.search(LOGGED_OUT_RE, r.stdout + r.stderr)
                msg = "logged in" if ok else "not logged in"
            except (OSError, subprocess.TimeoutExpired) as e:
                ok, msg = False, "status check failed: %s" % e
    elif acct.get("base_url"):
        try:
            with urllib.request.urlopen(acct["base_url"].rstrip("/") + v.get("health", "/"), timeout=3) as r:
                body = json.loads(r.read().decode("utf-8", "replace") or "{}")
            models = [m.get("name") or m.get("id") for m in (body.get("models") or body.get("data") or []) if isinstance(m, dict)]
            msg = "up (%d models)" % len(models) if models else "up"
        except Exception as e:
            ok, msg = False, "down (%s)" % e
    prev = prevc.get("ok")
    acct["check"] = {"ok": ok, "at": iso(now()), "msg": msg}
    if missing:
        acct["check"]["missing_cli"] = True
    if not ok and prevc.get("rejected"):
        acct["check"]["rejected"] = prevc["rejected"]
    if models is not None:
        acct["models"] = models
    deck.save(acct, "accounts", acct["id"] + ".json")
    fix = "" if ok else (v.get("install", "install the vendor CLI") if missing else "run: deck account login %s" % acct["id"] if auth != "none" else "start the server at %s" % acct.get("base_url"))
    if prev != ok and (prev is not None or not ok):  # flips, and a first check that already fails
        emit(deck, "AUTH", account=acct["id"], ok=ok, msg=msg if ok else "%s; %s" % (msg, fix))
    if not quiet:
        print("%s: %s%s" % (acct["id"], msg, "  ->  " + fix if fix else ""))
    return ok


def live_models(acct):
    """Model ids the vendor reports for this account right now, or None when the vendor cannot enumerate."""
    v, env = VENDORS.get(acct.get("vendor"), {}), acct_env(acct)
    try:
        if acct.get("base_url") and v.get("health"):
            with urllib.request.urlopen(acct["base_url"].rstrip("/") + v["health"], timeout=5) as r:
                body = json.loads(r.read().decode("utf-8", "replace") or "{}")
        elif acct.get("auth") == "apikey" and v.get("models_url") and env.get(acct.get("key_env", "")):
            key = env[acct["key_env"]]
            req = urllib.request.Request(v["models_url"].format(key=key), headers={h: x.format(key=key) for h, x in v.get("models_hdr", {}).items()})
            with urllib.request.urlopen(req, timeout=10) as r:
                body = json.loads(r.read().decode("utf-8", "replace") or "{}")
        elif acct.get("auth") == "oauth" and v.get("models_cmd"):
            r = subprocess.run(v["models_cmd"], shell=True, env=dict(os.environ, **env), capture_output=True, text=True, timeout=60)
            if r.returncode != 0:
                return None
            ids = {m.group(1) for m in re.finditer(r"^\s*[-*]?\s*([A-Za-z0-9][\w.:/\-\[\]=,]*[\w\]])\s+(?:-\s|$)", r.stdout, re.M)}  # "id - Name" or bare id lines
            return sorted(i for i in ids if i.lower() not in ("available", "models", "model", "tip"))
        else:
            return None
        items = body.get("models") or body.get("data") or []
        return sorted({(m.get("name") or m.get("id") or "").split("models/")[-1] for m in items if isinstance(m, dict) and (m.get("name") or m.get("id"))})
    except Exception:
        return None


def sync_models(deck, quiet=True):
    """Ask every account that can enumerate models; mark catalog entries available/unavailable per vendor."""
    m, seen, report = deck.models(), {}, []
    for acct in deck.items("accounts"):
        lst = live_models(acct)
        if lst is None:
            continue
        acct["models"], acct["models_at"] = lst, iso(now())
        deck.save(acct, "accounts", acct["id"] + ".json")
        seen.setdefault(acct.get("vendor"), set()).update(lst)
        report.append("%s: %d live models" % (acct["id"], len(lst)))
    for h in deck.items("hands"):  # every model a hand names is a catalog entry
        if h.get("model"):
            m["models"].setdefault(h["model"], {"id": h["model"], "vendor": h.get("vendor")})
    for mid, rec in m["models"].items():
        if rec.get("vendor") in seen:
            ok = any(mid == x or mid.split("[")[0] == x for x in seen[rec["vendor"]])
            rec.update(available=ok, seen=iso(now()))
            if not ok:
                report.append("%s: not offered by %s right now" % (mid, rec["vendor"]))
    m["synced"] = iso(now())
    deck.save(m, "models.json")
    if not quiet:
        print("\n".join(report) or "no account can enumerate models (Cursor, API-key accounts and local servers can)")
    return m


def model_state(deck_models, model):
    rec = (deck_models.get("models") or {}).get(model or "") or {}
    return "no-model" if rec.get("available") is False else None


def auth_state(acct):
    """None when usable, else 'needs-login' (oauth/apikey) or 'down' (local server)."""
    c = acct.get("check") or {}
    if c.get("ok") is not False:
        return None
    return "no-cli" if c.get("missing_cli") else "needs-login" if acct.get("auth", "none") != "none" else "down"


def _default_login_exists(v, probe):
    st = v.get("status")
    try:
        if st.startswith("file:"):
            return (Path(os.path.expanduser("~")) / st[5:]).exists()
        r = subprocess.run(st, shell=True, env=dict(os.environ, **acct_env(probe)), capture_output=True, text=True, timeout=30)
        return r.returncode == 0 and not re.search(LOGGED_OUT_RE, r.stdout + r.stderr)
    except (OSError, subprocess.TimeoutExpired):
        return False


def auth_ok(deck, acct, max_age=3600):
    """Cached auth state, refreshed when stale or previously failing, so a run never burns a claim on a dead login."""
    if acct.get("auth", "none") == "none" and not acct.get("base_url"):
        return True
    c = acct.get("check") or {}
    if c.get("ok") and c.get("at") and (now() - ts(c["at"])).total_seconds() < max_age:
        return True
    return check_account(deck, acct)


# ---------- deck ----------
class Deck:
    def __init__(self, root):
        self.root = Path(root).resolve()

    @classmethod
    def find(cls):
        if os.environ.get("DECK_ROOT"):
            return cls(os.environ["DECK_ROOT"])
        d = Path.cwd()
        for p in [d] + list(d.parents):
            if (p / ".deck" / "deck.json").exists():
                return cls(p / ".deck")
        die("no .deck/ here or above (run `deck init`, or set DECK_ROOT)")

    def p(self, *parts):
        return self.root.joinpath(*parts)

    def load(self, *parts):
        f = self.p(*parts)
        if not f.exists():
            die("not found: %s" % f.relative_to(self.root))
        return self.parse(f)

    def parse(self, f):
        try:
            obj = json.loads(f.read_text(encoding="utf-8"))
            if not isinstance(obj, dict):
                raise ValueError("expected a JSON object")
            return obj
        except ValueError as e:
            die("bad JSON in %s: %s" % (f.relative_to(self.root), e))

    def save(self, obj, *parts):
        f = self.p(*parts)
        f.parent.mkdir(parents=True, exist_ok=True)
        tmp = f.with_name("%s.%d.tmp" % (f.name, os.getpid()))
        tmp.write_text(json.dumps(obj, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        os.replace(tmp, f)

    def items(self, kind):
        pat = "*/task.json" if kind == "tasks" else "*.json"
        return sorted((self.parse(f) for f in self.p(kind).glob(pat)), key=lambda o: o.get("id", ""))

    def rows(self, name):
        f = self.p(name)
        rows = []
        for i, line in enumerate(f.read_text(encoding="utf-8").splitlines() if f.exists() else []):
            try:
                rows.append(json.loads(line)) if line.strip() else None
            except ValueError:  # a torn line must not take the whole deck down
                print("deck: skipping bad line %d in %s" % (i + 1, name), file=sys.stderr)
        return rows

    def models(self):
        f = self.p("models.json")
        return self.parse(f) if f.exists() else {"updated": None, "models": {}}

    def append(self, name, row):
        with open(str(self.p(name)), "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row) + "\n")


def emit(deck, type_, **kw):
    ev = {"ts": iso(now()), "type": type_}
    ev.update({k: v for k, v in kw.items() if v not in (None, "")})
    deck.append("events.jsonl", ev)
    hooks = deck.p("hooks.d")
    for h in sorted(hooks.iterdir()) if hooks.is_dir() else []:
        if not (h.is_file() and os.access(str(h), os.X_OK) and re.match(r"(%s|any)([-._]|$)" % re.escape(type_), h.name)):
            continue
        env = dict(os.environ, DECK_ROOT=str(deck.root), DECK_EVENT=json.dumps(ev), DECK_EVENT_TYPE=type_,
                   DECK_TASK=str(ev.get("task", "")), DECK_HAND=str(ev.get("hand", "")))
        try:
            subprocess.run([str(h)], input=json.dumps(ev), text=True, env=env, timeout=60, cwd=str(deck.root.parent))
        except Exception as e:  # hooks must never break the deck
            print("deck: hook %s failed: %s" % (h.name, e), file=sys.stderr)
    return ev


def local_usage(acct, horizon):
    """Ground truth for subscriptions: the vendor CLI's own session logs on this login (every session, interactive
    included). Claude Code writes one JSONL record per assistant turn with message.usage. Returns [(ts, in, out)] or None."""
    v = VENDORS.get(acct.get("vendor"), {})
    if acct.get("auth") != "oauth" or not v.get("usage_logs"):
        return None
    home = acct_env(acct).get(v.get("home") or "") or os.path.expanduser(v.get("default_home", "~"))
    root = Path(home) / v["usage_logs"]
    if not root.is_dir():
        return None
    cutoff, rows, seen = time.time() - horizon, [], set()
    for f in root.rglob("*.jsonl"):
        if f.stat().st_mtime < cutoff:
            continue
        with open(str(f), encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if '"usage"' not in line:
                    continue
                try:
                    o = json.loads(line)
                except ValueError:
                    continue
                m, t = o.get("message") or {}, o.get("timestamp")
                u = m.get("usage") if isinstance(m, dict) else None
                if not isinstance(u, dict) or not t:
                    continue
                key = o.get("requestId") or m.get("id") or o.get("uuid")
                if key in seen:
                    continue
                seen.add(key)
                rows.append((t, sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")), int(u.get("output_tokens") or 0)))
    return rows


def _epoch_iso(v):
    try:
        v = float(v)
        return iso(dt.datetime.fromtimestamp(v / 1000 if v > 1e12 else v, dt.timezone.utc))
    except (TypeError, ValueError):
        return None


def usage_key(home):
    return hashlib.sha1(os.path.realpath(os.path.expanduser(home)).encode()).hexdigest()[:12]


def acct_home(acct):
    v = VENDORS.get(acct.get("vendor"), {})
    return acct_env(acct).get(v.get("home") or "") or os.path.expanduser(v.get("default_home", "~"))


def tap_windows(acct):
    """The latest reading the deck's own statusline tap recorded for this login (see cmd_tap). Local file, no network."""
    if acct.get("auth") != "oauth" or not VENDORS.get(acct.get("vendor"), {}).get("usage_cache"):
        return None
    f = Path(USAGE).expanduser() / (usage_key(acct_home(acct)) + ".json")
    try:
        r = json.loads(f.read_text(encoding="utf-8"))
        return r if r.get("windows") and r.get("at") else None
    except (OSError, ValueError):
        return None


def claude_cache_windows(acct):
    """Claude Code's own cached utilization in <home>/.claude.json (written by the official client; local file)."""
    v = VENDORS.get(acct.get("vendor"), {})
    if acct.get("auth") != "oauth" or not v.get("usage_cache"):
        return None
    try:
        c = json.loads((Path(acct_home(acct)) / v["usage_cache"]).read_text(encoding="utf-8")).get("cachedUsageUtilization") or {}
    except (OSError, ValueError):
        return None
    u = c.get("utilization") or {}
    wins = {w: {"percent": float(x["utilization"]), "reset_at": (x.get("resets_at") or "")[:19] + "Z" if x.get("resets_at") else None}
            for k, w in (("five_hour", "5h"), ("seven_day", "1w")) for x in [u.get(k)] if isinstance(x, dict) and x.get("utilization") is not None}
    return {"windows": wins, "at": _epoch_iso(c.get("fetchedAtMs")), "source": "claude-cache"} if wins and c.get("fetchedAtMs") else None


def vendor_usage(deck, acct):
    """Freshest official-surface reading of the vendor's own utilization numbers. Never the network, never a token."""
    cands = [r for r in (tap_windows(acct), claude_cache_windows(acct)) if r and r.get("at")]
    return max(cands, key=lambda r: r["at"]) if cands else None


def refresh_remote(deck, acct, max_age=60):
    """Re-read the local utilization sources at most once a minute; learn tokens-per-percent when a fresher reading lands."""
    rem = acct.get("remote") or {}
    if rem.get("checked") and (now() - ts(rem["checked"])).total_seconds() < max_age:
        return
    r = vendor_usage(deck, acct)
    if r is None:
        return
    if rem.get("at") and r["at"] > rem["at"] and rem.get("windows", {}).get("5h") and r["windows"].get("5h"):
        d_pct = r["windows"]["5h"]["percent"] - rem["windows"]["5h"]["percent"]
        logs = local_usage(acct, dur("5h")) or []
        toks = sum(a + b for t, a, b in logs if rem["at"] < t[:19] + "Z" <= r["at"])
        if d_pct > 0 and toks > 0:
            acct["tokens_per_pct"] = round(toks / d_pct)
    if r.get("tokens_per_pct"):
        acct["tokens_per_pct"] = r["tokens_per_pct"]
    acct["remote"] = dict(r, checked=iso(now()))
    deck.save(acct, "accounts", acct["id"] + ".json")


def headroom(acct, ledger):
    """Tightest of the account's rate windows (`limits: {"5h": 200, "1w": 1000}`), from the ledger plus an optional
    fresh `remote` reading (`deck account sync`). Subscription windows are estimates unless synced."""
    t, metric = now(), acct.get("metric", "runs")
    limits = acct.get("limits") or ({acct["window"]: acct["limit"]} if acct.get("limit") else {acct.get("window", "5h"): None})
    mine = [r for r in ledger if r.get("account") == acct["id"]]
    logs = local_usage(acct, max(dur(w) for w in limits))
    wins = []
    for win, limit in limits.items():
        rows = [r for r in mine if (t - ts(r["ts"])).total_seconds() < dur(win)]
        sums = {"runs": sum(r.get("units", 1) for r in rows), "tokens": sum((r.get("tokens_in") or 0) + (r.get("tokens_out") or 0) for r in rows),
                "usd": round(sum(r.get("cost_usd") or 0 for r in rows), 4)}
        first = min((r["ts"] for r in rows), default=None)
        if logs is not None:  # every session on this login, not just deck runs
            lrows = [r for r in logs if (t - ts(r[0])).total_seconds() < dur(win)]
            sums.update(tokens=sum(a + b for _, a, b in lrows), requests=len(lrows), source="logs")
            first = min([r[0] for r in lrows] + ([first] if first else []), default=None)
        used = sums.get(metric, sums["runs"])
        wins.append(dict(sums, window=win, used=used, limit=limit, frac=max(0.0, 1 - used / limit) if limit else 1.0,
                         reset_at=iso(ts(first) + dt.timedelta(seconds=dur(win))) if first else None))
    rem = acct.get("remote") or {}
    if rem.get("windows") and rem.get("at") and (t - ts(rem["at"])).total_seconds() < 7 * 86400:
        detail, age = {w["window"]: w for w in wins}, (t - ts(rem["at"])).total_seconds()
        since = sum(a + b for tt, a, b in (logs or []) if tt[:19] + "Z" > rem["at"])  # tokens this login spent after the reading
        wins = []
        for w, x in rem["windows"].items():
            pct, est = x["percent"], False
            if x.get("reset_at") and ts(x["reset_at"]) <= t:
                pct, est = 0.0, False  # the window has reset since the reading
            elif since and acct.get("tokens_per_pct"):
                pct, est = min(100.0, pct + since / acct["tokens_per_pct"]), True
            wins.append(dict(detail.get(w, {}), window=w, used=round(pct, 1), limit=100, metric="%", remote=True, est=est, source=rem.get("source"),
                             reading_age=age, frac=max(0.0, 1 - pct / 100), reset_at=x.get("reset_at") or detail.get(w, {}).get("reset_at")))
    elif rem.get("limit") and rem.get("at") and (t - ts(rem["at"])).total_seconds() < 3600:  # usage_cmd style {used, limit, window?, reset_at?}
        wins.append({"window": rem.get("window", "remote"), "used": rem["used"], "limit": rem["limit"], "remote": True,
                     "frac": max(0.0, 1 - rem["used"] / rem["limit"]), "reset_at": rem.get("reset_at")})
    tight, cool = min(wins, key=lambda w: (w["frac"], dur(w["window"]) if re.fullmatch(r"\d+[smhdw]", w["window"]) else 0)), acct.get("cooldown_until")
    state = "cooldown" if cool and ts(cool) > t else "exhausted" if tight["limit"] and tight["used"] >= tight["limit"] else "ok"
    return dict(tight, account=acct["id"], metric=tight.get("metric", metric), windows=wins, state=state,
                left=(tight["limit"] - tight["used"]) if tight["limit"] else None, cooldown_until=cool if state == "cooldown" else None)


def claim_of(deck, hand):
    f = deck.p("claims", hand + ".json")
    if not f.exists():
        return None
    c = deck.parse(f)
    return c if not c.get("until") or ts(c["until"]) > now() else None


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, TypeError, ValueError):
        return False


def reap(deck):
    """Close tasks whose detached runner died (crash, reboot) so hands and tasks never stay stuck."""
    for t in deck.items("tasks"):
        if t.get("status") == "running" and t.get("pid") and not alive(t["pid"]) and (now() - ts(t.get("started", iso(now())))).total_seconds() > 30:
            finish(deck, t, "FAILED", "deck", msg="runner pid %s died" % t["pid"])


def roster(deck):
    reap(deck)
    ledger, catalog = deck.rows("ledger.jsonl"), deck.models()
    accts = {a["id"]: a for a in deck.items("accounts")}
    for a in accts.values():
        refresh_remote(deck, a)
    hr = {aid: headroom(a, ledger) for aid, a in accts.items()}
    last, spend = {r.get("hand"): r["ts"] for r in ledger}, {}
    for r in ledger:
        if (now() - ts(r["ts"])).total_seconds() < 7 * 86400 and r.get("hand"):
            sp = spend.setdefault(r["hand"], [0, 0.0, 0])
            sp[0] += 1
            sp[1] += r.get("cost_usd") or 0
            sp[2] += (r.get("tokens_in") or 0) + (r.get("tokens_out") or 0)
    res = []
    for h in deck.items("hands"):
        c, a = claim_of(deck, h["id"]), hr.get(h.get("account"))
        bad = auth_state(accts.get(h.get("account")) or {}) or model_state(catalog, h.get("model"))
        state = "claimed" if c else "no-account" if not a else bad if bad else "free" if a["state"] == "ok" else a["state"]
        sp = spend.get(h["id"])
        res.append(dict(h, state=state, claim=c, headroom=a, last_used=last.get(h["id"]),
                        observed={"runs_7d": sp[0], "avg_usd": round(sp[1] / sp[0], 3), "avg_tokens": int(sp[2] / sp[0])} if sp else None))
    return res


def model_args(v, model, effort):
    """Expand the {model} placeholder: vendor model flag + effort flag (Cursor: `--model name[effort=high]`)."""
    flag = v.get("flag", "--model")
    if v.get("effort_in_model") and model and effort:
        return " %s %s" % (flag, shlex.quote("%s[effort=%s]" % (model, effort)))
    out = " %s %s" % (flag, shlex.quote(model)) if model else ""
    if effort and v.get("effort"):
        out += v["effort"].format(effort=shlex.quote(effort))
    return out


def route(deck, cost=None, vendor=None, needs=(), model=None):
    order = {c: i for i, c in enumerate(COSTS)}
    notes = deck.models().get("models", {}) if needs else {}
    cands = [h for h in roster(deck) if h["state"] == "free" and (not vendor or h.get("vendor") == vendor)]
    cands.sort(key=lambda h: (-(bool(model) and h.get("model") == model),  # a hand already on the requested model needs no override
                              -len(set(needs) & set((notes.get(h.get("model") or "") or {}).get("good_for", []))),
                              abs(order.get(h.get("cost", "mid"), 1) - order.get(cost, 1)) if cost else 0,
                              -h["headroom"]["frac"], h.get("last_used") or ""))
    return cands


def do_claim(deck, hand, task, by, ttl):
    c = claim_of(deck, hand)
    if c:
        die("hand %s is claimed by %s (task %s) until %s" % (hand, c["by"], c.get("task"), c.get("until")))
    f = deck.p("claims", hand + ".json")
    if f.exists():
        f.unlink()
    rec = {"hand": hand, "task": task, "by": by, "since": iso(now()), "until": iso(now() + dt.timedelta(seconds=dur(ttl)))}
    try:
        fd = os.open(str(f), os.O_WRONLY | os.O_CREAT | os.O_EXCL)
    except FileExistsError:
        die("hand %s was just claimed by someone else" % hand)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(rec, fh, indent=2)
    emit(deck, "CLAIM", hand=hand, task=task, by=by)
    return rec


def do_release(deck, hand, by, task=None):
    f = deck.p("claims", hand + ".json")
    if f.exists():
        f.unlink()
        emit(deck, "RELEASE", hand=hand, task=task, by=by)


def finish(deck, task, status, by, **ev):
    task["status"] = FINAL[status]
    task["finished"] = iso(now())
    task.pop("pid", None)
    deck.save(task, "tasks", task["id"], "task.json")
    c = claim_of(deck, task["hand"]) if task.get("hand") else None
    if c and c.get("task") == task["id"]:
        do_release(deck, task["hand"], by, task["id"])
    return emit(deck, status, task=task["id"], hand=task.get("hand"), by=by, **ev)


# ---------- commands ----------
def cmd_tap(a):
    """Statusline command for Claude Code: record rate_limits for this login, print a remaining-first HUD line. Never fails."""
    raw = sys.stdin.read()
    try:
        p = json.loads(raw) if raw.strip() else {}
    except ValueError:
        p = {}
    home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    wins = {}
    for k, w in (("five_hour", "5h"), ("seven_day", "1w")):
        x = (p.get("rate_limits") or {}).get(k) if isinstance(p.get("rate_limits"), dict) else None
        if isinstance(x, dict) and isinstance(x.get("used_percentage"), (int, float)):
            wins[w] = {"percent": max(0.0, min(100.0, float(x["used_percentage"]))), "reset_at": _epoch_iso(x.get("resets_at"))}
    if wins:
        try:
            d = Path(USAGE).expanduser()
            d.mkdir(parents=True, exist_ok=True)
            rec = {"at": iso(now()), "source": "tap", "home": os.path.realpath(home), "windows": wins, "model": (p.get("model") or {}).get("id"),
                   "context_pct": (p.get("context_window") or {}).get("used_percentage"), "session_cost_usd": (p.get("cost") or {}).get("total_cost_usd")}
            tmp = d / ("%s.%d.tmp" % (usage_key(home), os.getpid()))
            tmp.write_text(json.dumps(rec), encoding="utf-8")
            os.replace(str(tmp), str(d / (usage_key(home) + ".json")))
        except OSError:
            pass
    if a.chain:  # keep the user's existing statusline: same payload in, its output out
        try:
            r = subprocess.run(a.chain, shell=True, input=raw, capture_output=True, text=True, timeout=5)
            sys.stdout.write(r.stdout)
            return 0
        except (OSError, subprocess.TimeoutExpired):
            pass
    parts = ["%s %d%% left" % (w, round(100 - x["percent"])) + (" ↻%s" % x["reset_at"][11:16] if x.get("reset_at") else "") for w, x in wins.items()]
    ctx = (p.get("context_window") or {}).get("used_percentage")
    if isinstance(ctx, (int, float)):
        parts.append("ctx %d%% left" % round(100 - ctx))
    print("deck · " + " · ".join(parts) if parts else "deck · (no rate_limits in payload)")
    return 0


def account_tap(deck, acct, a):
    """Wire `deck tap` as the statusline of this login's Claude Code, chaining any existing statusline instead of replacing it."""
    if acct.get("auth") != "oauth" or not VENDORS.get(acct.get("vendor"), {}).get("usage_cache"):
        die("tap works for Claude Code logins (vendor claude, auth oauth)")
    f = Path(acct_home(acct)) / "settings.json"
    try:
        settings = json.loads(f.read_text(encoding="utf-8")) if f.exists() else {}
    except ValueError:
        die("%s is not valid JSON" % f)
    me = "%s tap" % shlex.quote(os.path.abspath(__file__))
    cur = (settings.get("statusLine") or {}).get("command", "")
    if a.off:
        if me in cur:
            bak = settings.pop("statusLine_deck_bak", None)
            settings.pop("statusLine", None)
            if bak:
                settings["statusLine"] = bak
        msg = "tap removed from %s" % f
    elif me in cur:
        msg = "tap already wired in %s" % f
    else:
        if cur:
            settings["statusLine_deck_bak"] = settings["statusLine"]
        settings["statusLine"] = {"type": "command", "command": me + (" --chain %s" % shlex.quote(cur) if cur else "")}
        msg = "tap wired into %s%s\nopen one Claude Code session on this login; the HUD line confirms and `deck status` shows live %% of window" % (f, " (chained after your existing statusline)" if cur else "")
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    return out(a, settings.get("statusLine"), msg)


def cmd_init(a):
    root = Path(a.path or ".").resolve() / ".deck"
    for d in ("accounts", "hands", "tasks", "claims", "hooks.d"):
        (root / d).mkdir(parents=True, exist_ok=True)
    if not (root / "deck.json").exists():
        Deck(root).save({"version": 1, "name": a.name or root.parent.name}, "deck.json")
    for f in ("events.jsonl", "ledger.jsonl"):
        (root / f).touch()
    (root / "AGENTS.md").write_text(AGENTS_MD, encoding="utf-8")
    out(a, {"deck": str(root)}, "deck ready: %s\n"
        "read:  %s/AGENTS.md\n"
        "next:  deck account add <id> --vendor claude|codex|cursor|gemini|ollama|lmstudio   (an agent can do this)\n"
        "       deck account login <id> [--headless]                                       (a human does this)\n"
        "       deck hand add <id> --account <id> [--model M]" % (root, root))


def parse_price(s):  # "3/15" -> USD per million tokens in/out
    m = re.fullmatch(r"([\d.]+)/([\d.]+)", s or "")
    return {"in": float(m.group(1)), "out": float(m.group(2))} if m else die("bad price %r (use IN/OUT per 1M tokens, e.g. 3/15)" % s)


def account_add(deck, a):
    f = deck.p("accounts", a.id + ".json")
    rec = dict(deck.parse(f) if f.exists() else {}, id=a.id)
    for k in ("vendor", "login", "metric", "notes", "base_url", "usage_cmd", "status_cmd", "login_cmd", "monthly_usd", "plan"):
        if getattr(a, k) is not None:
            rec[k] = getattr(a, k)
    rec.setdefault("vendor", "custom")
    v = VENDORS.get(rec["vendor"], {})
    rec.setdefault("metric", "tokens" if v.get("usage_logs") else "runs")  # subscriptions with local logs count real tokens
    if a.metric and rec.get("limits") and a.limit is None:
        print("deck: metric is now %s but limits %s were set under the old metric; reset them with --limit N/WINDOW (0 clears)" % (a.metric, rec["limits"]), file=sys.stderr)
    if a.limit is not None:
        limits = {}
        for spec in a.limit:
            n, _, win = spec.partition("/")
            limits[win or "5h"] = int(n)
            dur(win or "5h")
        rec["limits"] = {w: n for w, n in limits.items() if n} or None
        rec.pop("limit", None), rec.pop("window", None)
    rec["auth"] = a.auth or rec.get("auth") or ("oauth" if v.get("home") else "apikey" if v.get("key") or a.key_env else "none")
    if rec["auth"] == "apikey":
        rec["key_env"] = a.key_env or rec.get("key_env") or v.get("key") or die("--key-env NAME required for an apikey account on vendor %r" % rec["vendor"])
    env = dict(rec.get("env", {}))
    if rec["auth"] == "oauth" and v.get("home") and a.home != "default":
        env[v["home"]] = a.home or env.get(v["home"]) or "%s/%s" % (HOMES, a.id)
    if v.get("base_url"):
        rec.setdefault("base_url", v["base_url"])
        for k, val in v.get("env", {}).items():
            env.setdefault(k, val.format(base_url=rec["base_url"]))
    if a.env:
        env.update(dict(kv.split("=", 1) for kv in a.env))
    if env:
        rec["env"] = env
    if a.price:
        rec["price"] = parse_price(a.price)
    deck.save(rec, "accounts", a.id + ".json")
    emit(deck, "ACCOUNT", account=a.id, by=who(a))
    if a.login_now:
        print("account %s saved (%s, auth=%s)" % (a.id, rec["vendor"], rec["auth"]))
        return account_login(deck, rec, a)
    ok = check_account(deck, rec)
    hint = "" if ok else ("\nnext: deck account login %s%s" % (a.id, "   (add --headless on a box without a browser)" if rec["auth"] == "oauth" else "")
                          if rec["auth"] != "none" else "\nserver not reachable at %s" % rec.get("base_url"))
    if not ok and rec["auth"] == "oauth" and v.get("home") and v.get("status") and rec.get("env", {}).get(v["home"]):
        probe = dict(rec, env={k: x for k, x in rec["env"].items() if k != v["home"]})  # the vendor's default dir
        if _default_login_exists(v, probe):
            hint += "\nnote: this machine already has a %s login in the default dir; to reuse it: deck account add %s --home default" % (rec["vendor"], a.id)
    if ok and rec["auth"] == "oauth" and v.get("usage_cache") and not tap_windows(rec):
        hint += "\nlive subscription usage: deck account tap %s   (statusline tap; official surface, no network)" % a.id
    if v.get("billing_hint") and not rec.get("limits"):
        hint += "\n" + v["billing_hint"]
    out(a, rec, "account %s saved (%s, auth=%s, limits=%s): %s%s" % (a.id, rec["vendor"], rec["auth"], rec.get("limits") or "none", rec["check"]["msg"], hint))


def account_login(deck, acct, a):
    v, auth = VENDORS.get(acct.get("vendor"), {}), acct.get("auth", "none")
    env = dict(os.environ, **acct_env(acct))
    if auth == "apikey":
        if a.from_env:
            key = os.environ.get(a.from_env) or die("$%s is empty" % a.from_env)
        elif a.from_file:
            key = Path(a.from_file).read_text(encoding="utf-8").strip()
        elif not sys.stdin.isatty():
            key = sys.stdin.read().strip()
        else:
            key = getpass.getpass("%s for account %s (hidden, stored in %s): " % (acct["key_env"], acct["id"], secret_backend()))
        key or die("no key given")
        backend = secret_set(acct["id"], key)
        if a.from_file:
            os.remove(a.from_file)
        print("stored %s for %s in %s (sha256 %s). The deck folder holds no secret." % (acct["key_env"], acct["id"], backend, hashlib.sha256(key.encode()).hexdigest()[:12]))
    elif auth == "oauth":
        for k, val in env.items():
            if k == v.get("home"):
                Path(val).mkdir(parents=True, exist_ok=True)
                os.chmod(val, 0o700)
        cmd = acct.get("login_cmd") or (v.get("headless") if a.headless else None) or v.get("login") or die(
            "no login command for vendor %r; log in with the vendor's own tool using env %s, then `deck account check %s`" % (acct["vendor"], acct.get("env"), acct["id"]))
        if a.headless:
            env.update(v.get("headless_env", {}))
        print("Logging in account %s via `%s`. Tokens are kept by the vendor CLI under %s - never in the deck.%s%s" % (
            acct["id"], cmd, env.get(v.get("home") or "", "its default dir"), "\n(%s)" % v["login_hint"] if v.get("login_hint") else "",
            "\nAGENT: relay the URL / one-time code below to the human; if the vendor then asks for a code, paste the one the human gives you here." if a.headless else ""), flush=True)
        subprocess.call(cmd, shell=True, env=env)  # interactive: browser or device-code flow, the human finishes it
    else:
        die("account %s (auth=none) needs no login; try `deck account check %s`" % (acct["id"], acct["id"]))
    ok = check_account(deck, acct, quiet=False)
    return 0 if ok else 1


def cmd_account(deck, a):
    if a.sub == "add":
        return account_add(deck, a)
    if a.sub == "login":
        return account_login(deck, deck.load("accounts", a.id + ".json"), a)
    if a.sub == "tap":
        return account_tap(deck, deck.load("accounts", a.id + ".json"), a)
    if a.sub == "check":
        accts = [deck.load("accounts", a.id + ".json")] if a.id else deck.items("accounts")
        oks = [check_account(deck, x, quiet=a.json) for x in accts]
        return out(a, [x.get("check") for x in accts]) if a.json else (0 if all(oks) else 1)
    if a.sub == "logout":
        acct = deck.load("accounts", a.id + ".json")
        v = VENDORS.get(acct.get("vendor"), {})
        if acct.get("auth") == "apikey":
            secret_del(a.id)
        elif v.get("logout"):
            subprocess.call(v["logout"], shell=True, env=dict(os.environ, **acct_env(acct)))
        else:
            die("no logout command for %s; remove its login dir: %s" % (a.id, acct.get("env")))
        check_account(deck, acct)
        return out(a, acct, "logged out %s" % a.id)
    if a.sub == "sync":
        acct = deck.load("accounts", a.id + ".json")
        if not acct.get("usage_cmd") and (vendor_usage(deck, acct) is not None or local_usage(acct, 3600) is not None):
            refresh_remote(deck, acct, max_age=0)
            hr = headroom(acct, deck.rows("ledger.jsonl"))
            return out(a, hr, "\n".join("%s: %s%s%s" % (w["window"], "%s%d%% used (%s, read %s), resets %s" % ("≈" if w.get("est") else "", w["used"], w.get("source"), acct.get("remote", {}).get("at"), w.get("reset_at")) if w.get("metric") == "%" else "",
                                                     " | %s tok, %s requests on this login" % (w.get("tokens"), w.get("requests")) if w.get("requests") is not None else "",
                                                     " | %d%% of your limit" % round(100 * w["used"] / w["limit"]) if w.get("limit") and w.get("metric") != "%" else "") for w in hr["windows"]))
        cmd = acct.get("usage_cmd") or die("account %s has no usage_cmd (a command printing JSON {used, limit, window?, reset_at?})" % a.id)
        r = subprocess.run(cmd, shell=True, env=dict(os.environ, **acct_env(acct)), capture_output=True, text=True, timeout=120)
        rem = json.loads(r.stdout or "{}") if r.returncode == 0 else die("usage_cmd failed: %s" % (r.stderr or r.stdout).strip())
        acct["remote"] = dict(rem, at=iso(now()))
        deck.save(acct, "accounts", a.id + ".json")
        return out(a, acct["remote"], "synced %s: %s/%s used" % (a.id, rem.get("used"), rem.get("limit")))
    if a.sub == "rm":
        deck.p("accounts", a.id + ".json").unlink()
        return out(a, {"removed": a.id}, "removed account %s (secret, if any, kept; `deck account logout` first to drop it)" % a.id)
    if a.sub == "cooldown":
        rec = deck.load("accounts", a.id + ".json")
        rec["cooldown_until"] = None if a.clear else a.until or iso(now() + dt.timedelta(seconds=dur(a.for_ or "1h")))
        deck.save(rec, "accounts", a.id + ".json")
        emit(deck, "COOLDOWN", account=a.id, until=rec["cooldown_until"], by=who(a))
        return out(a, rec, "account %s cooldown until %s" % (a.id, rec["cooldown_until"]))
    ledger, accts = deck.rows("ledger.jsonl"), deck.items("accounts")
    for x in accts:
        refresh_remote(deck, x)
    rows = [dict(x, headroom=headroom(x, ledger)) for x in accts]

    out(a, rows, table(["ACCOUNT", "VENDOR", "AUTH", "STATE", "HEADROOM", "CHECKED", "$/MO", "LOGIN"],
                       [[r["id"], r.get("vendor", ""), r.get("auth", "?"), auth_state(r) or r["headroom"]["state"], head_text(r["headroom"], r),
                         (r.get("check") or {}).get("at", "never")[:16], r.get("monthly_usd") or "-", r.get("login", "")] for r in rows]) if rows else "no accounts")


def head_text(hr, acct=None):
    """The number that matters per billing kind: % of window for subscriptions, $ for API, tokens for local."""
    if not hr:
        return "-"
    auth, w = (acct or {}).get("auth", "none"), hr["window"]
    tok = "%.1fM tok" % (hr.get("tokens", 0) / 1e6) if hr.get("tokens", 0) >= 1e6 else "%dk tok" % (hr.get("tokens", 0) / 1e3)
    if hr.get("limit"):
        if hr.get("metric") == "%":
            age = hr.get("reading_age") or 0
            core = "%s%d%% of %s (%s%s)" % ("≈" if hr.get("est") else "", round(hr["used"]), w, hr.get("source", "vendor"), " %s ago" % fdur(age) if age > 120 else "")
        else:
            core = "%d%% of %s" % (round(100 * hr["used"] / hr["limit"]), w) + (" (synced)" if hr.get("remote") else "")
        return core + (" · $%.2f" % hr["usd"] if auth == "apikey" else " · " + tok if hr.get("requests") is not None else "")
    if auth == "apikey":
        return "$%.2f in %s" % (hr.get("usd", 0), w)
    if hr.get("source") == "logs":
        return "%s in %s (all sessions)" % (tok, w)
    return tok + " in %s" % w if auth == "none" else "%s runs in %s" % (hr.get("runs", hr["used"]), w)


def cmd_hand(deck, a):
    if a.sub == "add":
        f = deck.p("hands", a.id + ".json")
        rec = dict(deck.parse(f) if f.exists() else {}, id=a.id)
        acct = deck.load("accounts", (a.account or rec.get("account") or die("--account required")) + ".json")
        rec["account"], rec["vendor"] = acct["id"], a.vendor or rec.get("vendor") or acct.get("vendor")
        for k in ("model", "effort", "cost", "cmd", "notes"):
            if getattr(a, k):
                rec[k] = getattr(a, k)
        if rec.get("cmd") == "default":
            rec.pop("cmd")
        if "cmd" not in rec:
            if rec["vendor"] not in VENDORS:
                die("--cmd required for vendor %r (built-in templates: %s)" % (rec["vendor"], ", ".join(VENDORS)))
            v = VENDORS[rec["vendor"]]
            rec["cmd"] = v["cmd"]  # {model} {prompt} {taskdir} resolve at run time, so --model/--effort can override per run
            rec.setdefault("cost", v["cost"])
        rec.setdefault("cost", "mid")
        if a.price:
            rec["price"] = parse_price(a.price)
        deck.save(rec, "hands", a.id + ".json")
        emit(deck, "HAND", hand=a.id, account=acct["id"], by=who(a))
        return out(a, rec, "hand %s saved -> %s\n  cmd: %s" % (a.id, acct["id"], rec["cmd"]))
    if a.sub == "rm":
        deck.p("hands", a.id + ".json").unlink()
        return out(a, {"removed": a.id}, "removed hand %s" % a.id)
    rows = roster(deck)
    out(a, rows, table(["HAND", "VENDOR", "ACCOUNT", "MODEL", "COST", "STATE"],
                       [[h["id"], h.get("vendor", ""), h.get("account", ""), h.get("model", "-"), h.get("cost", ""), h["state"]] for h in rows]) if rows else "no hands")


def cmd_status(deck, a):
    ro, counts = roster(deck), {}
    accts = {x["id"]: x for x in deck.items("accounts")}
    for t in deck.items("tasks"):
        counts[t["status"]] = counts.get(t["status"], 0) + 1
    if a.json:
        return out(a, {"deck": str(deck.root), "hands": ro, "tasks": counts})
    rows = []
    for h in ro:
        hr, c = h["headroom"] or {}, h["claim"]
        note = ("by %s on %s" % (c["by"], c.get("task", "?")) if c else
                "run: deck account login %s" % h.get("account") if h["state"] == "needs-login" else
                "server down (deck account check %s)" % h.get("account") if h["state"] == "down" else
                "CLI not installed (deck account check %s)" % h.get("account") if h["state"] == "no-cli" else
                "model unavailable: deck models probe %s --hand %s" % (h.get("model"), h["id"]) if h["state"] == "no-model" else
                "until %s" % hr["cooldown_until"] if h["state"] == "cooldown" else
                "resets in %s" % fdur((ts(hr["reset_at"]) - now()).total_seconds()) if hr.get("reset_at") else "")
        ob = h.get("observed")
        rows.append([h["id"], h.get("model") or "-", h.get("account", ""), h.get("cost", ""), "$%.2f/%dk" % (ob["avg_usd"], ob["avg_tokens"] / 1000) if ob else "-",
                     h["state"], head_text(hr, accts.get(h.get("account"))), note])
    print(table(["HAND", "MODEL", "ACCOUNT", "COST", "OBSERVED", "STATE", "HEADROOM", "NOTE"], rows) if rows else "no hands (deck hand add ...)")
    print("tasks: " + (", ".join("%s %d" % kv for kv in sorted(counts.items())) or "none"))
    upd = deck.models().get("updated")
    if ro and (not upd or (now() - ts(upd)).total_seconds() > 7 * 86400):
        print("model notes %s -> deck models refresh --run" % ("never refreshed" if not upd else "%d days old" % ((now() - ts(upd)).days)))


def why_no_hand(deck):
    """One line per unusable hand with its fix, so an agent can act instead of guessing."""
    fixes = {"needs-login": "deck account login %(account)s", "down": "deck account check %(account)s", "no-cli": "vendor CLI not installed: deck account check %(account)s",
             "no-model": "model %(model)s unavailable: deck models probe %(model)s --hand %(id)s",
             "claimed": "held by %(by)s until %(until)s", "cooldown": "until %(cooldown_until)s", "exhausted": "resets %(reset_at)s",
             "no-account": "deck account add %(account)s"}
    lines = []
    for h in roster(deck):
        info = dict(h, **(h.get("claim") or {}), **(h.get("headroom") or {}))
        lines.append("%s: %s (%s)" % (h["id"], h["state"], fixes.get(h["state"], "") % info))
    return "no free hand" + ("; " + "; ".join(lines) if lines else " (deck hand add ...)")


def cmd_route(deck, a):
    ranked = route(deck, a.cost, a.vendor)
    out(a, ranked, table(["#", "HAND", "COST", "HEADROOM", "LAST USED"],
                         [[i + 1, h["id"], h.get("cost", ""), "%d%%" % round(h["headroom"]["frac"] * 100), h.get("last_used") or "never"]
                          for i, h in enumerate(ranked)]) if ranked else why_no_hand(deck))
    return 0 if ranked else 2


def cmd_task(deck, a):
    if a.sub == "add":
        tid = a.id or "t-%s-%s" % (now().strftime("%m%d"), uuid.uuid4().hex[:4])
        if deck.p("tasks", tid, "task.json").exists():
            die("task exists: %s" % tid)
        rec = {"id": tid, "title": a.title, "status": "open", "created": iso(now()), "runs": 0}
        for k in ("cost", "model", "effort"):
            if getattr(a, k):
                rec[k] = getattr(a, k)
        if a.needs:
            rec["needs"] = [x.strip() for x in a.needs.split(",") if x.strip()]
        if a.cwd:
            rec["cwd"] = str(Path(a.cwd).resolve())
        deck.save(rec, "tasks", tid, "task.json")
        deck.p("tasks", tid, "CONTEXT.md").write_text(read_text_arg(a) or CONTEXT_MD.format(title=a.title), encoding="utf-8")
        emit(deck, "TASK", task=tid, by=who(a), msg=a.title)
        return out(a, rec, tid)
    if a.sub == "show":
        t = deck.load("tasks", a.id, "task.json")
        ctx, hf = (deck.p("tasks", a.id, n) for n in ("CONTEXT.md", "HANDOFF.md"))
        t["context"], t["handoff"] = (f.read_text(encoding="utf-8") if f.exists() else None for f in (ctx, hf))
        return out(a, t, "%s\n\n--- CONTEXT.md ---\n%s\n--- HANDOFF.md ---\n%s" % (json.dumps({k: v for k, v in t.items() if k not in ("context", "handoff")}, indent=2), t["context"] or "", t["handoff"] or "(none)"))
    if a.sub == "set":
        t = deck.load("tasks", a.id, "task.json")
        for kv in a.kv:
            k, v = kv.split("=", 1)
            try:
                t[k] = json.loads(v)
            except ValueError:
                t[k] = v
        deck.save(t, "tasks", a.id, "task.json")
        return out(a, t, "updated %s" % a.id)
    rows = [t for t in deck.items("tasks") if not a.status or t["status"] in a.status.split(",")]
    out(a, rows, table(["TASK", "STATUS", "HAND", "RUNS", "TITLE"], [[t["id"], t["status"], t.get("hand") or "-", t.get("runs", 0), t["title"]] for t in rows]) if rows else "no tasks")


