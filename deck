def spawn_runs(deck, a):
    """Detach one `deck run` per task; each claims its own hand, so N tasks on N free hands run in parallel."""
    flags = [x for k in ("hand", "cost", "vendor", "model", "effort", "cwd", "ttl", "timeout", "by") if getattr(a, k) for x in ("--" + k, getattr(a, k))]
    pids = []
    for tid in a.task:
        deck.load("tasks", tid, "task.json")
        log = deck.p("tasks", tid, "runs")
        log.mkdir(exist_ok=True)
        with open(str(log / "bg.log"), "a", encoding="utf-8") as fh:
            p = subprocess.Popen([sys.executable, os.path.abspath(__file__), "run", tid, "--json"] + flags + (["--force"] if a.force else []),
                                 stdout=fh, stderr=fh, stdin=subprocess.DEVNULL, start_new_session=True, env=dict(os.environ, DECK_ROOT=str(deck.root)))
        pids.append({"task": tid, "pid": p.pid})
    out(a, pids, "\n".join("started %s (pid %d) - wake on: deck events -f --type END,BLOCKED,FAILED ; or: deck wait %s" % (p["task"], p["pid"], p["task"]) for p in pids))


def cmd_run(deck, a):
    if a.bg or len(a.task) > 1:
        return spawn_runs(deck, a)
    task = deck.load("tasks", a.task[0], "task.json")
    if task["status"] == "running" and not a.force:
        die("task %s is already running (use --force)" % task["id"])
    by = who(a)
    model = a.model or task.get("model")
    vendor = a.vendor or (deck.models().get("models", {}).get(model) or {}).get("vendor") if model and not a.hand else a.vendor
    ranked = [deck.load("hands", a.hand + ".json")] if a.hand else route(deck, a.cost or task.get("cost"), vendor, task.get("needs") or [], model)
    if a.dry:
        if not ranked:
            out(a, {"status": "BLOCKED", "msg": why_no_hand(deck)}, why_no_hand(deck))
            return 2
        hand = ranked[0]
    else:
        hand = None
        for cand in ranked:  # first claim that sticks wins; losing a race just means trying the next hand
            if not auth_ok(deck, deck.load("accounts", cand["account"] + ".json")):
                if a.hand:
                    die("account %s needs login: deck account login %s" % (cand["account"], cand["account"]))
                print("deck: skipping %s: account %s needs login" % (cand["id"], cand["account"]), file=sys.stderr)
                continue
            if getattr(a, "_probe", False):  # a probe is one tiny call; it may run on a hand the caller already holds
                hand = cand
                break
            try:
                do_claim(deck, cand["id"], task["id"], by, a.ttl)
                hand = cand
                break
            except SystemExit as e:
                if a.hand:
                    raise
                print(str(e), file=sys.stderr)
        if not hand:
            msg = why_no_hand(deck)
            task.pop("hand", None)
            finish(deck, task, "BLOCKED", by, msg=msg)
            out(a, {"status": "BLOCKED", "msg": msg}, "BLOCKED: " + msg)
            return 2
    acct = deck.load("accounts", hand["account"] + ".json")
    tdir = deck.p("tasks", task["id"])
    ctx, hf = tdir / "CONTEXT.md", tdir / "HANDOFF.md"
    prompt = PROMPT.format(id=task["id"], title=task["title"], handoff=hf, context=ctx.read_text(encoding="utf-8") if ctx.exists() else task["title"])
    model, effort = model or hand.get("model"), a.effort or task.get("effort") or hand.get("effort")
    if (a.model or a.effort) and "{model}" not in hand["cmd"] and "{effort}" not in hand["cmd"]:
        print("deck: hand %s has a fixed cmd (no {model} placeholder); --model/--effort ignored. Regenerate: deck hand add %s --cmd default" % (hand["id"], hand["id"]), file=sys.stderr)
    cmd = (hand["cmd"].replace("{context}", shlex.quote(str(ctx))).replace("{handoff}", shlex.quote(str(hf)))
           .replace("{taskdir}", shlex.quote(str(tdir))).replace("{task}", task["id"])
           .replace("{model}", model_args(VENDORS.get(hand.get("vendor"), {}), model, effort)).replace("{effort}", effort or ""))
    if len(prompt) > 100000:  # Linux caps a single argv string at 128KB; every vendor CLI also reads the prompt from stdin
        cmd = re.sub(r"\s*\{prompt\}", "", cmd)
    stdin = None if "{prompt}" in cmd else prompt
    cmd = cmd.replace("{prompt}", shlex.quote(prompt))
    cwd = a.cwd or task.get("cwd") or str(deck.root.parent)
    if a.dry:
        return out(a, {"hand": hand["id"], "model": model, "effort": effort, "cwd": cwd, "cmd": cmd, "stdin": stdin},
                   "hand: %s  model: %s  effort: %s\ncwd:  %s\ncmd:  %s%s" % (hand["id"], model or "-", effort or "-", cwd, cmd, "\n--- stdin ---\n" + stdin if stdin else ""))
    task.update(status="running", hand=hand["id"], runs=task.get("runs", 0) + 1, pid=os.getpid(), started=iso(now()))
    deck.save(task, "tasks", task["id"], "task.json")
    n = task["runs"]
    emit(deck, "START", task=task["id"], hand=hand["id"], by=by, run=n, model=model, effort=effort)
    env = dict(os.environ, **acct_env(acct))
    env.update(DECK_ROOT=str(deck.root), DECK_TASK=task["id"], DECK_HAND=hand["id"], DECK_CONTEXT=str(ctx), DECK_HANDOFF=str(hf))
    before, t0, msg = hf.stat().st_mtime if hf.exists() else 0, time.time(), None
    try:
        p = subprocess.run(cmd, shell=True, cwd=cwd, input=stdin, capture_output=True, env=env,
                           encoding="utf-8", errors="replace", timeout=dur(a.timeout) if a.timeout else None)
        output, code = (p.stdout or "") + (p.stderr or ""), p.returncode
    except subprocess.TimeoutExpired as e:
        dec = lambda b: b.decode("utf-8", "replace") if isinstance(b, bytes) else (b or "")
        output, code = dec(e.stdout) + dec(e.stderr) + "\n[deck] timeout after %s" % a.timeout, 124
        msg = "timeout after %s" % a.timeout
    except OSError as e:  # bad cwd, argv too long, etc. Must still release the claim and close the task.
        output, code, msg = "[deck] could not start worker: %s" % e, 126, "could not start worker: %s" % e
    secs = round(time.time() - t0)
    (tdir / "runs").mkdir(exist_ok=True)
    (tdir / "runs" / ("%d.log" % n)).write_text(output, encoding="utf-8")
    usage, price = parse_usage(output), hand.get("price") or acct.get("price") or (deck.models().get("models", {}).get(model or "") or {}).get("price")
    if price and not usage.get("cost_usd") and (usage.get("tokens_in") or usage.get("tokens_out")):
        usage["cost_usd"] = round((usage.get("tokens_in", 0) * price.get("in", 0) + usage.get("tokens_out", 0) * price.get("out", 0)) / 1e6, 6)
    wrote = hf.exists() and hf.stat().st_mtime > before
    if wrote:
        status = parse_status(hf.read_text(encoding="utf-8"))
    elif code == 0:
        status = "END"
    elif model and re.search(MODEL_ERR_RE, output):
        status, msg = "FAILED", "model %s rejected by %s" % (model, hand.get("vendor") or acct["id"])
        m = deck.models()
        m["models"].setdefault(model, {"id": model, "vendor": hand.get("vendor")}).update(available=False, seen=iso(now()), error=result_text(output, 3)[:200])
        deck.save(m, "models.json")
        emit(deck, "MODEL", model=model, hand=hand["id"], ok=False, by=by, msg=msg)
    elif re.search(AUTH_FAIL_RE, output):
        status, msg = "BLOCKED", "login needed on account %s: deck account login %s" % (acct["id"], acct["id"])
        acct["check"] = {"ok": False, "at": iso(now()), "msg": "worker reported an auth failure"}
        if acct.get("auth") == "apikey" and env.get(acct.get("key_env", "")):
            acct["check"]["rejected"] = hashlib.sha256(env[acct["key_env"]].encode()).hexdigest()[:12]
        deck.save(acct, "accounts", acct["id"] + ".json")
        emit(deck, "AUTH", account=acct["id"], ok=False, by=by, msg=msg)
    elif re.search(RATE_LIMIT_RE, output):
        status, msg = "BLOCKED", "rate limited on account %s" % acct["id"]
        hinted = parse_reset(output)  # the vendor usually says when
        resets = [w.get("reset_at") for w in (acct.get("remote") or {}).get("windows", {}).values() if w.get("reset_at")]
        acct["cooldown_until"] = (hinted if hinted and ts(hinted) > now() else min(r for r in resets if ts(r) > now()) if any(ts(r) > now() for r in resets)
                                  else iso(now() + dt.timedelta(seconds=dur(acct.get("cooldown") or ("5m" if acct.get("auth") == "apikey" else "1h")))))
        msg += "; usable again %s" % acct["cooldown_until"]
        deck.save(acct, "accounts", acct["id"] + ".json")
        emit(deck, "COOLDOWN", account=acct["id"], until=acct["cooldown_until"], by=by, msg=msg)
    else:
        status, msg = "FAILED", msg or "exit %d" % code
    if not wrote:
        hf.write_text(HANDOFF_MD.format(status="%s (auto: worker exited %d without writing a handoff)" % (status, code),
                                        body="Output tail:\n\n```\n%s\n```" % result_text(output)), encoding="utf-8")
    deck.append("ledger.jsonl", dict({"ts": iso(now()), "account": acct["id"], "hand": hand["id"], "model": model, "task": task["id"], "run": n,
                                      "units": 1, "seconds": secs, "exit": code}, **usage))
    ev = finish(deck, task, status, by, run=n, seconds=secs, exit=code, msg=msg, **usage)
    out(a, dict(ev, handoff=str(hf), log=str(tdir / "runs" / ("%d.log" % n))),
        "%s %s on %s (%s, exit %d%s)\nhandoff: %s" % (status, task["id"], hand["id"], fdur(secs), code, "; " + msg if msg else "", hf))
    if msg and msg.startswith("model ") and not getattr(a, "_probe", False) and not task["id"].startswith("models-refresh"):
        retry = recover_model(deck, a, task)
        if retry is not None:
            return retry
    return {"END": 0, "BLOCKED": 2, "FAILED": 1}[status]


def recover_model(deck, a, task):
    """Self-heal after a model error: refresh the catalog via a research task, then re-route the task once."""
    pending = [t for t in deck.items("tasks") if t["id"].startswith("models-refresh") and t["status"] in ("open", "running")]
    if not pending:
        ns = argparse.Namespace(sub="refresh", if_stale=False, days=7, run=True, json=True, by=who(a))
        with contextlib.redirect_stdout(io.StringIO()):
            cmd_models(deck, ns)
        print("deck: model error -> catalog marked, research task dispatched (deck models)", file=sys.stderr)
    if not a.hand and not getattr(a, "_retried", False):
        print("deck: re-routing %s once, avoiding the rejected model" % task["id"], file=sys.stderr)
        t = deck.load("tasks", task["id"], "task.json")
        if t.get("model"):
            t["rejected_model"], t["model"] = t.pop("model"), None
            deck.save(t, "tasks", task["id"], "task.json")
        a._retried, a.model = True, None
        return cmd_run(deck, a)


def cmd_wait(deck, a):
    deadline = time.time() + (dur(a.timeout) if a.timeout else 10 ** 9)
    pending, results = list(a.task), {}
    while pending and time.time() < deadline:
        reap(deck)
        for tid in list(pending):
            t = deck.load("tasks", tid, "task.json")
            if t["status"] not in ("open", "running"):
                results[tid] = t
                pending.remove(tid)
                if not a.json:
                    print("%s %s on %s%s" % (t["status"].upper(), tid, t.get("hand") or "-", "  -> " + str(deck.p("tasks", tid, "HANDOFF.md")) if t["status"] != "open" else ""), flush=True)
        if pending:
            time.sleep(1)
    if a.json:
        out(a, {"done": results, "pending": pending})
    return 3 if pending else 0 if all(t["status"] == "done" for t in results.values()) else 1


def cmd_models(deck, a):
    m, f = deck.models(), deck.p("models.json")
    if a.sub == "set":
        rec = dict(m["models"].get(a.model, {}), id=a.model)
        for kv in a.kv:
            k, _, v = kv.partition("=")
            if k in ("good_for", "efforts"):
                rec[k] = [x.strip() for x in v.split(",") if x.strip() and x.strip() != "-"]
            elif k == "price":
                rec[k] = parse_price(v) if v not in ("0", "-", "") else {"in": 0, "out": 0}
            else:
                try:
                    rec[k] = json.loads(v)  # true/false/numbers become real values
                except ValueError:
                    rec[k] = v
        m["models"][a.model], m["updated"] = rec, iso(now())
        deck.save(m, "models.json")
        return out(a, rec, "noted %s" % a.model)
    if a.sub == "rm":
        m["models"].pop(a.model, None), deck.save(m, "models.json")
        return out(a, m, "removed %s" % a.model)
    age = (now() - ts(m["updated"])).total_seconds() / 86400 if m.get("updated") else None
    stale = age is None or age > a.days if hasattr(a, "days") else age is None or age > 7
    if a.sub == "refresh":
        if a.if_stale and not stale:
            return out(a, {"stale": False, "updated": m["updated"]}, "model notes are %.1f days old; fresh enough" % age)
        open_ = [t for t in deck.items("tasks") if t["id"].startswith("models-refresh") and t["status"] in ("open", "running")]
        if open_:
            return out(a, open_[0], "refresh already pending: %s (%s)" % (open_[0]["id"], open_[0]["status"]))
        tid = "models-refresh-%s" % now().strftime("%y%m%d")
        vendors = sorted({h.get("vendor") for h in deck.items("hands") if h.get("vendor")}) or sorted(VENDORS)
        rec = {"id": tid, "title": "Refresh model notes", "status": "open", "created": iso(now()), "runs": 0, "cost": "low", "needs": ["research"]}
        deck.save(rec, "tasks", tid, "task.json")
        deck.p("tasks", tid, "CONTEXT.md").write_text(MODELS_RESEARCH.format(path=f, vendors=", ".join(vendors),
                                                      cmds=", ".join("`%s`" % VENDORS[v]["cmd"].split(" ")[0] for v in vendors if v in VENDORS)), encoding="utf-8")
        emit(deck, "TASK", task=tid, by=who(a), msg=rec["title"])
        if a.run:
            a.task, a.bg, a.hand, a.cost, a.vendor, a.model, a.effort, a.cwd, a.ttl, a.timeout, a.force, a.dry = [tid], True, None, "low", None, None, None, None, "2h", "30m", False, False
            return cmd_run(deck, a)
        return out(a, rec, "created %s (model notes %s). Dispatch: deck run %s --bg" % (tid, "never refreshed" if age is None else "%.1f days old" % age, tid))
    if a.sub == "sync":
        m = sync_models(deck, quiet=a.json)
        return out(a, m) if a.json else None
    if a.sub == "probe":
        return probe_model(deck, a)
    synced = m.get("synced")
    if not getattr(a, "no_sync", False) and (not synced or (now() - ts(synced)).total_seconds() > 86400):
        m = sync_models(deck)
    mine = {x.get("vendor") for x in deck.items("accounts")}
    rows = sorted((r for r in m["models"].values() if getattr(a, "all", False) or r.get("vendor") in mine), key=lambda r: r.get("id", ""))
    if getattr(a, "live", False):
        return out(a, {x["id"]: x.get("models") for x in deck.items("accounts")},
                   "\n".join("%s (%s): %s" % (x["id"], x.get("models_at", "-"), ", ".join(x.get("models") or ["(cannot enumerate)"])) for x in deck.items("accounts")))
    head = "model notes: %s%s" % ("never refreshed" if age is None else "updated %.1f days ago" % age, "  ->  deck models refresh" if stale else "")
    out(a, m, head + ("\n" + table(["MODEL", "VENDOR", "AVAIL", "COST", "$/M IN/OUT", "GOOD FOR", "EFFORTS", "CTX", "NOTES"],
                                    [[r.get("id"), r.get("vendor", ""), {True: "yes", False: "NO"}.get(r.get("available"), "?"), r.get("cost", ""),
                                      "%g/%g" % (r["price"].get("in", 0), r["price"].get("out", 0)) if isinstance(r.get("price"), dict) else "-",
                                      ",".join(r.get("good_for", [])), ",".join(r.get("efforts", [])) or "-", r.get("context", ""), (r.get("notes") or "")[:50]] for r in rows]) if rows else ""))


def probe_model(deck, a):
    """One tiny real call to verify a model id works on a hand; records availability either way."""
    hands = [deck.load("hands", a.hand + ".json")] if a.hand else [h for h in deck.items("hands") if not a.vendor or h.get("vendor") == a.vendor]
    hand = next((h for h in hands if h.get("model") == a.model), None) or (hands[0] if hands else die("no hand to probe with (use --hand)"))
    tid = "probe-%s" % uuid.uuid4().hex[:6]
    deck.save({"id": tid, "title": "probe %s" % a.model, "status": "open", "created": iso(now()), "runs": 0}, "tasks", tid, "task.json")
    deck.p("tasks", tid, "CONTEXT.md").write_text("Reply with exactly the single word OK and nothing else. Do not write any files.\n", encoding="utf-8")
    ns = argparse.Namespace(task=[tid], hand=hand["id"], cost=None, vendor=None, model=a.model, effort=None, cwd=None, ttl="10m", timeout="3m",
                            bg=False, force=False, dry=False, json=True, by=who(a), _probe=True)
    try:
        with contextlib.redirect_stdout(io.StringIO()):
            code = cmd_run(deck, ns)
        log = deck.p("tasks", tid, "runs", "1.log")
        output = log.read_text(encoding="utf-8") if log.exists() else ""
    except SystemExit as e:
        shutil.rmtree(str(deck.p("tasks", tid)), ignore_errors=True)
        raise
    ok = code == 0 and not re.search(MODEL_ERR_RE, output)
    m = deck.models()
    m["models"].setdefault(a.model, {"id": a.model, "vendor": hand.get("vendor")}).update(available=ok, seen=iso(now()), **({} if ok else {"error": result_text(output, 3)[:200]}))
    deck.save(m, "models.json")
    shutil.rmtree(str(deck.p("tasks", tid)), ignore_errors=True)
    emit(deck, "MODEL", model=a.model, hand=hand["id"], ok=ok, by=who(a), msg=None if ok else "probe failed: %s" % result_text(output, 3)[:120])
    out(a, {"model": a.model, "hand": hand["id"], "available": ok}, "%s on %s: %s" % (a.model, hand["id"], "available" if ok else "NOT available (%s)" % result_text(output, 3)[:120]))
    return 0 if ok else 1


def cmd_handoff(deck, a):
    task = deck.load("tasks", a.task, "task.json")
    hf = deck.p("tasks", a.task, "HANDOFF.md")
    text = read_text_arg(a)
    if a.text:
        text = HANDOFF_MD.format(status=a.status or "END", body=a.text)
    if text:
        hf.write_text(text, encoding="utf-8")
    if not hf.exists():
        die("no HANDOFF.md for %s; pass --text or --file" % a.task)
    status = a.status or parse_status(hf.read_text(encoding="utf-8"))
    ev = finish(deck, task, status, who(a), msg=a.text and a.text[:200])
    out(a, ev, "%s %s" % (status, a.task))


def cmd_usage(deck, a):
    deck.load("accounts", a.account + ".json")
    row = {"ts": iso(now()), "account": a.account, "hand": a.hand, "task": a.task, "units": a.units,
           "tokens_in": a.tokens_in, "tokens_out": a.tokens_out, "cost_usd": a.cost_usd, "by": who(a)}
    row = {k: v for k, v in row.items() if v is not None}
    deck.append("ledger.jsonl", row)
    out(a, row, "recorded usage on %s" % a.account)


def cmd_ledger(deck, a):
    since = now() - dt.timedelta(seconds=dur(a.since)) if a.since else None
    rows = [r for r in deck.rows("ledger.jsonl") if (not a.account or r.get("account") == a.account) and (not since or ts(r["ts"]) >= since)]
    tot = {}
    for r in rows:
        t = tot.setdefault(r.get("account", "?"), {"account": r.get("account", "?"), "runs": 0, "units": 0, "tokens_in": 0, "tokens_out": 0, "cost_usd": 0.0, "seconds": 0})
        t["runs"] += 1
        for k in ("units", "tokens_in", "tokens_out", "cost_usd", "seconds"):
            t[k] += r.get(k) or 0
    subs = {x["id"]: x["monthly_usd"] for x in deck.items("accounts") if x.get("monthly_usd")}
    out(a, {"rows": rows, "totals": list(tot.values()), "subscriptions_usd_per_month": subs},
        (table(["ACCOUNT", "RUNS", "UNITS", "TOKENS IN", "TOKENS OUT", "API USD", "TIME"],
               [[t["account"], t["runs"], t["units"], t["tokens_in"], t["tokens_out"], "%.4f" % t["cost_usd"], fdur(t["seconds"])] for t in tot.values()]) if tot else "ledger empty")
        + ("\nsubscriptions: $%.2f/mo (%s)" % (sum(subs.values()), ", ".join("%s $%g" % kv for kv in subs.items())) if subs else ""))


def cmd_events(deck, a):
    since = now() - dt.timedelta(seconds=dur(a.since)) if a.since else None
    types = set(a.type.upper().split(",")) if a.type else None

    def fmt(e):
        return json.dumps(e) if a.json else "%s %-8s %s" % (e["ts"], e["type"], " ".join("%s=%s" % kv for kv in e.items() if kv[0] not in ("ts", "type")))

    def ok(e):
        return (not since or ts(e["ts"]) >= since) and (not types or e["type"] in types)

    f = deck.p("events.jsonl")
    for e in [e for e in deck.rows("events.jsonl") if ok(e)][-a.n:]:
        print(fmt(e), flush=True)
    if not a.follow:
        return
    with open(str(f), encoding="utf-8") as fh:
        fh.seek(0, 2)
        while True:
            line = fh.readline()
            if not line:
                time.sleep(0.5)
                continue
            if line.strip():
                e = json.loads(line)
                if ok(e):
                    print(fmt(e), flush=True)


def cmd_event(deck, a):
    out(a, emit(deck, a.type.upper(), task=a.task, hand=a.hand, by=who(a), msg=a.msg), "emitted %s" % a.type.upper())


