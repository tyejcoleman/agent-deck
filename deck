    q.add_argument("--from-env", help="apikey: read the key from this env var"), q.add_argument("--from-file", help="apikey: read the key from this file, then delete it")
    sp("check", cmd_account, "refresh auth/reachability state (never prints secrets)", s).add_argument("id", nargs="?")
    q = sp("tap", cmd_account, "wire `deck tap` as this Claude login's statusline: live subscription %% of window, official surface, no network", s)
    q.add_argument("id"), q.add_argument("--off", action="store_true", help="remove it (restores a chained statusline)")
    sp("ls", cmd_account, "list accounts with auth state and headroom", s)
    sp("logout", cmd_account, "drop the login / delete the stored key", s).add_argument("id")
