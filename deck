def cmd_mcp(_deck, _a):
    def reply(id_, result=None, error=None):
        msg = {"jsonrpc": "2.0", "id": id_}
        msg["error" if error else "result"] = error or result
        sys.stdout.write(json.dumps(msg) + "\n")
        sys.stdout.flush()

    tools = [{"name": n, "description": d, "inputSchema": {"type": "object", "properties": {p: {"type": "string"} for p in ps}, "required": req}}
             for n, d, _, ps, req in MCP_TOOLS]
    for line in sys.stdin:
        if not line.strip():
            continue
        req = json.loads(line)
        m, id_, params = req.get("method"), req.get("id"), req.get("params") or {}
        if m == "initialize":
            reply(id_, {"protocolVersion": params.get("protocolVersion", "2025-06-18"), "capabilities": {"tools": {}}, "serverInfo": {"name": "agent-deck", "version": VERSION}})
        elif m == "tools/list":
            reply(id_, {"tools": tools})
        elif m == "tools/call":
            spec = next((t for t in MCP_TOOLS if t[0] == params.get("name")), None)
            if not spec:
                reply(id_, error={"code": -32602, "message": "unknown tool %s" % params.get("name")})
                continue
            pos, flags = [], ["--json"]
            for k, v in (params.get("arguments") or {}).items():
                flag = spec[3].get(k, "?")
                if flag == "?" or v in (None, ""):
                    continue
                if flag is None:
                    pos.append(str(v))
                elif flag.endswith("!"):  # boolean switch
                    flags += [flag[:-1]] if str(v).lower() not in ("false", "0", "no") else []
                else:
                    flags += [flag, str(v)]
            buf, err = io.StringIO(), io.StringIO()
            with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(err):
                try:
                    code = main(list(spec[2]) + pos + flags) or 0
                except SystemExit as e:
                    code = 1
                    err.write(str(e))
            reply(id_, {"content": [{"type": "text", "text": (buf.getvalue() + err.getvalue()).strip() or "ok"}], "isError": code not in (0, 2)})
        elif m == "ping":
            reply(id_, {})
        elif id_ is not None:
            reply(id_, error={"code": -32601, "message": "method not found: %s" % m})


