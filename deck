    return ap


def main(argv=None):
    ap = build_parser()
    a = ap.parse_args(argv)
    if not getattr(a, "fn", None):
        getattr(a, "group", ap).print_help()
        return 1
    if a.fn in (cmd_init, cmd_tap):
        return a.fn(a)
    return a.fn(Deck.find(), a)


if __name__ == "__main__":
    sys.exit(main() or 0)
