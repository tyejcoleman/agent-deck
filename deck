    q.add_argument("--if-stale", action="store_true", help="only when older than --days"), q.add_argument("--days", type=float, default=7), q.add_argument("--run", action="store_true")
    p = sp("wait", cmd_wait, "block until the given tasks finish (for detached runs)")
    p.add_argument("task", nargs="+"), p.add_argument("--timeout")
    p = sp("handoff", cmd_handoff, "close a task by hand: write HANDOFF.md, emit END/BLOCKED")
    p.add_argument("task"), p.add_argument("--status", choices=tuple(FINAL)), p.add_argument("--text"), p.add_argument("--file", help="HANDOFF.md from file ('-' = stdin)")

    s = group("usage", "usage: add")
    q = sp("add", cmd_usage, "record a ledger row", s)
    q.add_argument("--account", required=True), q.add_argument("--hand"), q.add_argument("--task"), q.add_argument("--units", type=int, default=1)
    q.add_argument("--tokens-in", type=int), q.add_argument("--tokens-out", type=int), q.add_argument("--cost-usd", type=float)

