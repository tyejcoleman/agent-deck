        q.add_argument("--no-sync", action="store_true")
    groups["models"].add_argument("--json", action="store_true", help="machine-readable output")
    q = sp("set", cmd_models, "note a model: deck models set <id> vendor=claude good_for=reasoning,refactor cost=high efforts=low,medium,high", s)
    q.add_argument("model"), q.add_argument("kv", nargs="+")
    sp("rm", cmd_models, "forget a model", s).add_argument("model")
    sp("sync", cmd_models, "ask every account that can enumerate models (Cursor, API keys, local) and mark availability", s)
