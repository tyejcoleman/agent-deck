# name, description, base argv, {param: flag or None for positional}, required params
MCP_TOOLS = [
    ("deck_status", "Roster: every hand with state (free/claimed/exhausted/cooldown), account headroom, task counts.", ["status"], {}, []),
    ("deck_route", "Rank free hands for a task. cost: low|mid|high preference; vendor: claude|codex|cursor.", ["route"], {"cost": "--cost", "vendor": "--vendor"}, []),
    ("deck_task_add", "Create a task. title required; context = CONTEXT.md body; cost = low|mid|high; cwd = where the worker runs; id optional.", ["task", "add"], {"title": None, "context": "--text", "cost": "--cost", "cwd": "--cwd", "id": "--id"}, ["title"]),
    ("deck_task_ls", "List tasks, optionally filtered by status (open,running,done,blocked,failed).", ["task", "ls"], {"status": "--status"}, []),
    ("deck_task_show", "Show a task with its CONTEXT.md and HANDOFF.md.", ["task", "show"], {"id": None}, ["id"]),
    ("deck_run", "Dispatch a task: route (or use hand), claim, run the worker, record ledger, return END/BLOCKED/FAILED. Blocks until the worker exits. timeout like 30m.", ["run"], {"task": None, "hand": "--hand", "cost": "--cost", "vendor": "--vendor", "timeout": "--timeout", "by": "--by"}, ["task"]),
    ("deck_handoff", "Close a task manually: write HANDOFF.md text and emit END or BLOCKED.", ["handoff"], {"task": None, "status": "--status", "text": "--text", "by": "--by"}, ["task"]),
    ("deck_events", "Recent events (decklog). n = count; type = comma list e.g. END,BLOCKED; since like 2h.", ["events"], {"n": "-n", "type": "--type", "since": "--since"}, []),
    ("deck_ledger", "Usage totals per account (runs, tokens, cost, time). account filter; since like 24h.", ["ledger"], {"account": "--account", "since": "--since"}, []),
    ("deck_account_add", "Add/update an account (no secrets). vendor: claude|codex|cursor|gemini|ollama|lmstudio|custom; auth: oauth|apikey|none; limit like 200/5h; metric runs|tokens; price IN/OUT USD per 1M tokens; monthly_usd; env KEY=VAL. Afterwards a HUMAN must run `deck account login <id>` - never ask for a key in chat.", ["account", "add"], {"id": None, "vendor": "--vendor", "auth": "--auth", "limit": "--limit", "metric": "--metric", "price": "--price", "monthly_usd": "--monthly-usd", "login": "--login", "env": "--env", "base_url": "--base-url", "key_env": "--key-env"}, ["id"]),
    ("deck_account_ls", "Accounts with auth state (needs-login / ok / cooldown / exhausted), headroom per window, subscription price.", ["account", "ls"], {}, []),
    ("deck_account_check", "Re-check login / key presence / local server reachability for one account or all. Emits AUTH when state changes. Never returns secrets.", ["account", "check"], {"id": None}, []),
    ("deck_account_cooldown", "Mark an account exhausted for a duration (e.g. 2h), or clear=true to lift it.", ["account", "cooldown"], {"id": None, "for": "--for", "clear": "--clear!"}, ["id"]),
    ("deck_hand_add", "Add/update a hand preset bound to an account. model, cost (free|low|mid|high), price IN/OUT per 1M tokens, cmd (shell with {prompt}/{context}/{handoff}/{taskdir}); cmd defaults from the vendor template.", ["hand", "add"], {"id": None, "account": "--account", "vendor": "--vendor", "model": "--model", "cost": "--cost", "price": "--price", "cmd": "--cmd"}, ["id"]),
    ("deck_usage_add", "Record usage on an account by hand (for workers not run via deck run).", ["usage", "add"], {"account": "--account", "hand": "--hand", "task": "--task", "units": "--units", "tokens_in": "--tokens-in", "tokens_out": "--tokens-out", "cost_usd": "--cost-usd"}, ["account"]),
]


def cmd_mcp(_deck, _a):
    def reply(id_, result=None, error=None):
        msg = {"jsonrpc": "2.0", "id": id_}
        msg["error" if error else "result"] = error or result
        sys.stdout.write(json.dumps(msg) + "\n")
        sys.stdout.flush()

    tools = [{"name": n, "description": d, "inputSchema": {"type": "object", "properties": {p: {"type": "string"} for p in ps}, "required": req}}
             for n, d, _, ps, req in MCP_TOOLS]
    for line in sys.stdin:
        if not line.strip():
            continue
        req = json.loads(line)
        m, id_, params = req.get("method"), req.get("id"), req.get("params") or {}
        if m == "initialize":
            reply(id_, {"protocolVersion": params.get("protocolVersion", "2025-06-18"), "capabilities": {"tools": {}}, "serverInfo": {"name": "agent-deck", "version": VERSION}})
        elif m == "tools/list":
            reply(id_, {"tools": tools})
        elif m == "tools/call":
            spec = next((t for t in MCP_TOOLS if t[0] == params.get("name")), None)
            if not spec:
                reply(id_, error={"code": -32602, "message": "unknown tool %s" % params.get("name")})
                continue
            pos, flags = [], ["--json"]
            for k, v in (params.get("arguments") or {}).items():
                flag = spec[3].get(k, "?")
                if flag == "?" or v in (None, ""):
                    continue
                if flag is None:
                    pos.append(str(v))
                elif flag.endswith("!"):  # boolean switch
                    flags += [flag[:-1]] if str(v).lower() not in ("false", "0", "no") else []
                else:
                    flags += [flag, str(v)]
            buf, err = io.StringIO(), io.StringIO()
            with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(err):
                try:
                    code = main(list(spec[2]) + pos + flags) or 0
                except SystemExit as e:
                    code = 1
                    err.write(str(e))
            reply(id_, {"content": [{"type": "text", "text": (buf.getvalue() + err.getvalue()).strip() or "ok"}], "isError": code not in (0, 2)})
        elif m == "ping":
            reply(id_, {})
        elif id_ is not None:
            reply(id_, error={"code": -32601, "message": "method not found: %s" % m})


# ---------- argparse ----------
def build_parser():
    ap = argparse.ArgumentParser(prog="deck", description="Agent Deck: a roster of coding-agent hands, as files.")
    ap.add_argument("--version", action="version", version="deck " + VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="machine-readable output")
    common.add_argument("--by", help="who is acting (default $DECK_AGENT or 'deck')")
    sub = ap.add_subparsers(dest="cmd", metavar="<command>")

    def sp(name, fn, help_, parent=sub, **kw):
        p = parent.add_parser(name, help=help_, parents=[common], **kw)
        p.set_defaults(fn=fn, sub=name if parent is not sub else None)
        return p

    def group(name, help_):
        p = sub.add_parser(name, help=help_)
        p.set_defaults(fn=None, group=p)
        return p.add_subparsers(dest="sub", metavar="<sub>")

    p = sp("init", cmd_init, "create .deck/ here (idempotent)")
    p.add_argument("path", nargs="?"), p.add_argument("--name")

    s = group("account", "accounts: add | login | check | ls | logout | sync | cooldown | rm")
    q = sp("add", cmd_account, "add or update an account (then: deck account login <id>)", s)
    q.add_argument("id"), q.add_argument("--vendor", help="|".join(list(VENDORS) + ["custom"]))
    q.add_argument("--auth", choices=("oauth", "apikey", "none"), help="default: oauth if the vendor CLI has a login, else apikey")
    q.add_argument("--home", help="login dir for oauth (default %s/<id>; 'default' = the vendor's usual dir)" % HOMES)
    q.add_argument("--key-env", help="env var the CLI reads the API key from (custom vendors)"), q.add_argument("--base-url", help="local server URL")
    q.add_argument("--limit", action="append", help="N/WINDOW e.g. 200/5h, repeatable (N alone = per 5h; 0 clears)"), q.add_argument("--metric", choices=("runs", "tokens"))
    q.add_argument("--price", help="USD per 1M tokens IN/OUT, e.g. 3/15 (API accounts)"), q.add_argument("--monthly-usd", type=float, help="subscription price, informational")
    q.add_argument("--env", action="append", help="KEY=VAL applied when hands on this account run (repeatable)")
    q.add_argument("--login", help="who/where this is logged in (pointer, never a secret)"), q.add_argument("--usage-cmd", help="command printing JSON {used, limit, window?, reset_at?} for `deck account sync`")
    q.add_argument("--status-cmd", help="override the vendor's login-status command (exit 0 = logged in)"), q.add_argument("--login-cmd", help="override the vendor's login command"), q.add_argument("--notes")
    q.add_argument("--now", dest="login_now", action="store_true", help="run the login flow right after saving")
    q.add_argument("--headless", action="store_true", help="with --now: device-code / no-browser flow"), q.add_argument("--from-env"), q.add_argument("--from-file")
    q = sp("login", cmd_account, "human step: vendor login (browser/device code) or API key into the OS keychain", s)
    q.add_argument("id"), q.add_argument("--headless", action="store_true", help="no browser here: device code / paste-URL flow")
    q.add_argument("--from-env", help="apikey: read the key from this env var"), q.add_argument("--from-file", help="apikey: read the key from this file, then delete it")
    sp("check", cmd_account, "refresh auth/reachability state (never prints secrets)", s).add_argument("id", nargs="?")
    sp("ls", cmd_account, "list accounts with auth state and headroom", s)
    sp("logout", cmd_account, "drop the login / delete the stored key", s).add_argument("id")
    sp("sync", cmd_account, "run usage_cmd and store the vendor's own usage numbers", s).add_argument("id")
    sp("rm", cmd_account, "remove an account record", s).add_argument("id")
    q = sp("cooldown", cmd_account, "mark exhausted for a while", s)
    q.add_argument("id"), q.add_argument("--for", dest="for_", help="duration, e.g. 2h (default 1h)"), q.add_argument("--until", help="ISO time"), q.add_argument("--clear", action="store_true")

    s = group("hand", "hands: add | ls | rm")
    q = sp("add", cmd_hand, "add or update a hand preset", s)
    q.add_argument("id"), q.add_argument("--account"), q.add_argument("--vendor"), q.add_argument("--model"), q.add_argument("--cost", choices=COSTS)
    q.add_argument("--cmd", help="shell command; placeholders {prompt} {context} {handoff} {taskdir} {task}; 'default' regenerates from the vendor template"), q.add_argument("--price", help="USD per 1M tokens IN/OUT, e.g. 3/15"), q.add_argument("--notes")
    sp("ls", cmd_hand, "list hands", s)
    sp("rm", cmd_hand, "remove a hand", s).add_argument("id")

    sp("status", cmd_status, "the roster: what's free, claimed, exhausted")
    p = sp("route", cmd_route, "rank free hands (no side effects)")
    p.add_argument("--cost", choices=COSTS), p.add_argument("--vendor")

    s = group("task", "tasks: add | ls | show | set")
    q = sp("add", cmd_task, "create a task + CONTEXT.md", s)
    q.add_argument("title"), q.add_argument("--id"), q.add_argument("--cost", choices=COSTS), q.add_argument("--cwd", help="where the worker runs")
    q.add_argument("--file", help="CONTEXT.md from file ('-' = stdin)"), q.add_argument("--text", help="CONTEXT.md body")
    sp("ls", cmd_task, "list tasks", s).add_argument("--status", help="comma list")
    sp("show", cmd_task, "task + CONTEXT + HANDOFF", s).add_argument("id")
    q = sp("set", cmd_task, "set fields: deck task set <id> status=open cost=low", s)
    q.add_argument("id"), q.add_argument("kv", nargs="+")

    p = sp("claim", cmd_claim, "lease a hand")
    p.add_argument("hand"), p.add_argument("--task"), p.add_argument("--ttl", default="2h")
    sp("release", cmd_release, "release a hand").add_argument("hand")

    p = sp("run", cmd_run, "dispatch a task to a hand and wait for it")
    p.add_argument("task"), p.add_argument("--hand"), p.add_argument("--cost", choices=COSTS), p.add_argument("--vendor")
    p.add_argument("--cwd"), p.add_argument("--ttl", default="2h"), p.add_argument("--timeout", help="e.g. 30m"), p.add_argument("--dry", action="store_true", help="print command, don't run")
    p.add_argument("--force", action="store_true")

    p = sp("handoff", cmd_handoff, "close a task by hand: write HANDOFF.md, emit END/BLOCKED")
    p.add_argument("task"), p.add_argument("--status", choices=tuple(FINAL)), p.add_argument("--text"), p.add_argument("--file", help="HANDOFF.md from file ('-' = stdin)")

    s = group("usage", "usage: add")
    q = sp("add", cmd_usage, "record a ledger row", s)
    q.add_argument("--account", required=True), q.add_argument("--hand"), q.add_argument("--task"), q.add_argument("--units", type=int, default=1)
    q.add_argument("--tokens-in", type=int), q.add_argument("--tokens-out", type=int), q.add_argument("--cost-usd", type=float)

    p = sp("ledger", cmd_ledger, "usage totals per account")
    p.add_argument("--account"), p.add_argument("--since", help="e.g. 24h")
    p = sp("events", cmd_events, "read the decklog")
    p.add_argument("-n", type=int, default=20), p.add_argument("-f", "--follow", action="store_true"), p.add_argument("--type", help="comma list, e.g. END,BLOCKED"), p.add_argument("--since")
    p = sp("event", cmd_event, "emit an event (e.g. NOTE)")
    p.add_argument("type"), p.add_argument("--task"), p.add_argument("--hand"), p.add_argument("--msg")
    sp("mcp", cmd_mcp, "serve the deck over MCP stdio")
    return ap


def main(argv=None):
    ap = build_parser()
    a = ap.parse_args(argv)
    if not getattr(a, "fn", None):
        getattr(a, "group", ap).print_help()
        return 1
    if a.fn is cmd_init:
        return cmd_init(a)
    return a.fn(Deck.find(), a)


if __name__ == "__main__":
    sys.exit(main() or 0)
