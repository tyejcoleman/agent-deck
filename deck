    p.add_argument("--model", help="override the hand's model for this run"), p.add_argument("--effort", help="low|medium|high|xhigh|max (vendor-mapped; ignored where unsupported)")
    p.add_argument("--bg", action="store_true", help="detach; wake on END/BLOCKED/FAILED events or `deck wait`")
